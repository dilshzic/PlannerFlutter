<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Summary"
            android:textColor="@color/narwhal_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_summary_workload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="GRIND"
            android:textColor="@color/narwhal_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Large Progress Metric -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tv_summary_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/narwhal_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_summary_counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:text="0/0 Done"
            android:textColor="@color/narwhal_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Focus Time Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_schedule"
            android:contentDescription="Focus Time" />

        <TextView
            android:id="@+id/tv_summary_focus_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0h 0m Total Focus"
            android:textColor="@color/narwhal_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Open Dashboard Action Bar -->
    <TextView
        android:id="@+id/btn_open_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_item_background"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="Open Narwhal ➔"
        android:textColor="@color/narwhal_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
