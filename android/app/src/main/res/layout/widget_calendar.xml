<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:padding="12dp">

    <!-- Header: Month Name, Year & Navigation Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_calendar_month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="October 2026"
            android:textColor="@color/narwhal_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_calendar_today"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:src="@drawable/ic_calendar_today"
            android:contentDescription="Today" />

        <ImageView
            android:id="@+id/btn_calendar_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="2dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Previous Month" />

        <ImageView
            android:id="@+id/btn_calendar_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="2dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Next Month" />
    </LinearLayout>

    <!-- Day of Week Names Row (S M T W T F S) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="F"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/narwhal_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/narwhal_divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="Divider" />

    <!-- 6 Rows of 7 Day Cells (42 Cells Total) -->
    <!-- Row 0 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_0_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="1" />
        <TextView android:id="@+id/day_0_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="2" />
        <TextView android:id="@+id/day_0_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="3" />
        <TextView android:id="@+id/day_0_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="4" />
        <TextView android:id="@+id/day_0_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="5" />
        <TextView android:id="@+id/day_0_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="6" />
        <TextView android:id="@+id/day_0_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="7" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_1_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="8" />
        <TextView android:id="@+id/day_1_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="9" />
        <TextView android:id="@+id/day_1_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="10" />
        <TextView android:id="@+id/day_1_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="11" />
        <TextView android:id="@+id/day_1_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="12" />
        <TextView android:id="@+id/day_1_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="13" />
        <TextView android:id="@+id/day_1_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="14" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_2_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="15" />
        <TextView android:id="@+id/day_2_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="16" />
        <TextView android:id="@+id/day_2_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="17" />
        <TextView android:id="@+id/day_2_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="18" />
        <TextView android:id="@+id/day_2_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="19" />
        <TextView android:id="@+id/day_2_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="20" />
        <TextView android:id="@+id/day_2_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="21" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_3_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="22" />
        <TextView android:id="@+id/day_3_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="23" />
        <TextView android:id="@+id/day_3_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="24" />
        <TextView android:id="@+id/day_3_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="25" />
        <TextView android:id="@+id/day_3_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="26" />
        <TextView android:id="@+id/day_3_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="27" />
        <TextView android:id="@+id/day_3_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="28" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_4_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="29" />
        <TextView android:id="@+id/day_4_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="30" />
        <TextView android:id="@+id/day_4_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="31" />
        <TextView android:id="@+id/day_4_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_4_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_4_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_4_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/day_5_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_5" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
        <TextView android:id="@+id/day_5_6" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:text="" />
    </LinearLayout>

    <!-- Bottom Agenda Summary Bar -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/narwhal_divider"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Divider" />

    <LinearLayout
        android:id="@+id/layout_calendar_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_calendar_agenda_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap any date to view agenda"
            android:textColor="@color/narwhal_text_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_open_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_item_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Open ›"
            android:textColor="@color/narwhal_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
