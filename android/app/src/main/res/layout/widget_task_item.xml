<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_background"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- Interactive Checkbox -->
    <ImageView
        android:id="@+id/task_item_checkbox"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_check_box_outline"
        android:contentDescription="Toggle Task"
        android:padding="2dp" />

    <!-- Clickable Task Content Area (Opens App) -->
    <LinearLayout
        android:id="@+id/task_item_click_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="@color/narwhal_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_item_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Project"
                android:textColor="@color/narwhal_primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/task_item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="30m"
                android:textColor="@color/narwhal_text_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Priority Indicator Dot/Bar -->
    <ImageView
        android:id="@+id/task_item_priority"
        android:layout_width="4dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_chip_background"
        android:contentDescription="Priority Indicator"
        android:visibility="gone" />
</LinearLayout>
